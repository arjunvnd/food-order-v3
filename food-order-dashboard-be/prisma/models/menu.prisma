model Menu {
    id        String     @id @default(uuid())
    vendorId  String
    name      String
    isActive  Boolean    @default(false)
    vendor    Vendor     @relation(fields: [vendorId], references: [id])
    items     MenuItem[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    @@map("menus")
}
