model User {
    id         String      @id @default(uuid())
    auth0Sub   String      @unique
    email      String      @unique
    name       String?
    role       Role        @default(VENDOR)
    vendor     Vendor?
    mallAdmins MallAdmin[]
    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt

    @@map("users")
}
